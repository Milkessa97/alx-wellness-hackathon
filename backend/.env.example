# Example environment configuration (safe to commit)
GROQ_API_KEY=
# New — Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# New — JWT (generate a random 32+ char string)
JWT_SECRET=your_random_secret_here
JWT_ALGORITHM=HS256

# New — Google OAuth (the same client ID configured for the frontend origin;
# used to verify the audience of Google Identity Services credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# New — Email (for referral dispatch, demo uses SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_app_email@gmail.com
SMTP_PASSWORD=your_app_password_or_app_specific_password
EMAIL_FROM=PHQ-9 Reflect <your_app_email@gmail.com>

# New — App base URL (used in email links)
APP_BASE_URL=http://localhost:3000
INTERNAL_API_KEY=